# Copy to .env and edit. Never commit .env.

# ---------------------------------------------------------------- LLM
# "fake" = deterministic offline model: the full stack runs with no API key.
LLM_PROVIDER=fake

# Any OpenAI-compatible endpoint works. Uncomment one block:

# Ollama on your machine (with docker compose, use http://host.docker.internal:11434/v1;
# with `docker compose --profile local-llm`, use http://ollama:11434/v1)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=

# DeepSeek
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...

# Qwen via Alibaba Cloud DashScope (international endpoint)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-...

LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------- Persistence
# Empty = in-memory checkpointer (state is lost on restart).
# docker compose ignores this and always uses its own Postgres service.
# DATABASE_URL=postgresql://swarmops:swarmops@localhost:5432/swarmops
DATABASE_URL=
DB_POOL_MAX_SIZE=10

# ---------------------------------------------------------------- API
# Bearer token required on every route except /healthz. Empty = no authentication;
# only acceptable while the API is bound to localhost. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SWARMOPS_API_KEY=

# ---------------------------------------------------------------- Runtime
RECURSION_LIMIT=25
LOG_LEVEL=INFO

# ---------------------------------------------------------------- docker compose
# Local-development placeholders. Use a strong password if the database is reachable
# from anywhere other than your own machine.
POSTGRES_USER=swarmops
POSTGRES_PASSWORD=swarmops
POSTGRES_DB=swarmops
POSTGRES_PORT=5432
API_PORT=8000
